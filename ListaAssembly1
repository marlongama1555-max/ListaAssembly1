msg3: .asciiz "Area do terreno: "

.text
.globl main

main:
    # Ler largura
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Ler comprimento
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    # Calcular area = largura * comprimento
    mul $t2, $t0, $t1

    # Exibir resultado
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t2
    syscall

    # Encerrar
    li $v0, 10
    syscall
    

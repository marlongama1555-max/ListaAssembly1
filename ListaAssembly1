.text
.globl main

main:
    # Ler horas normais
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Ler horas extras
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    # Calcular pagamento das horas normais
    mul $t2, $t0, 10

    # Calcular pagamento das horas extras
    mul $t3, $t1, 15

    # Salario bruto = normal + extra
    add $t4, $t2, $t3

    # Ler desconto
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 5
    syscall
    move $t5, $v0

    # Salario liquido = bruto - desconto
    sub $t6, $t4, $t5


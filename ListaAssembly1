    syscall
    move $t1, $v0

    # Calcular cateto1²
    mul $t2, $t0, $t0

    # Calcular cateto2²
    mul $t3, $t1, $t1

    # Somar os quadrados
    add $t4, $t2, $t3

    # Converter para ponto flutuante
    mtc1 $t4, $f0
    cvt.s.w $f0, $f0

    # Calcular raiz quadrada
    sqrt.s $f2, $f0

    # Mostrar mensagem
    li $v0, 4
    la $a0, msg3
    syscall

    # Mostrar hipotenusa
    mov.s $f12, $f2
    li $v0, 2
    syscall

    # Encerrar
    li $v0, 10
    syscall
    
    .data

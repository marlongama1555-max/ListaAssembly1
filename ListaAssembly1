.text
.globl main

main:
    # Ler o primeiro numero
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 5
    syscall
    move $t0, $v0

    # Ler o segundo numero
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    # Verificar qual e o maior
    bgt $t0, $t1, primeiro_maior

    # Segundo numero e maior
    move $t2, $t1       # $t2 = maior
    move $t3, $t0       # $t3 = menor
    j calcular

primeiro_maior:
    move $t2, $t0       # $t2 = maior
    move $t3, $t1       # $t3 = menor

calcular:
    # Quociente = maior / menor
    div $t2, $t3
    mflo $t4             # $t4 = quociente

    # Multiplicar quociente pelo menor
    mul $t5, $t4, $t3

    # Resto = maior - (quociente * menor)
    sub $t6, $t2, $t5

    # Mostrar resultado
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t6
    syscall

    # Encerrar
    li $v0, 10
    syscall
    
    .data
msg:    .asciiz "Digite um numero (-1 para encerrar): "
msg0:   .asciiz "\n[0-25]: "
msg1:   .asciiz "\n[26-50]: "
msg2:   .asciiz "\n[51-75]: "
msg3:   .asciiz "\n[76-100]: "

.text
.globl main

main:
    # Inicializar contadores
    li $t0, 0       # contador [0-25]
    li $t1, 0       # contador [26-50]
    li $t2, 0       # contador [51-75]
    li $t3, 0       # contador [76-100]

ler:
    # Pedir numero
    li $v0, 4
    la $a0, msg
    syscall

    # Ler numero
    li $v0, 5
    syscall
    move $t4, $v0

    # Se for negativo, encerra
    bltz $t4, fim

    # Verificar se esta entre 0 e 25
    li $t5, 25
    ble $t4, $t5, intervalo_0

    # Verificar se esta entre 26 e 50
    li $t5, 50
    ble $t4, $t5, intervalo_1

    # Verificar se esta entre 51 e 75
    li $t5, 75
    ble $t4, $t5, intervalo_2

    # Verificar se esta entre 76 e 100
    li $t5, 100
    ble $t4, $t5, intervalo_3

    # Se for maior que 100, ignora e pede outro
    j ler

intervalo_0:
    addi $t0, $t0, 1
    j ler

intervalo_1:
    addi $t1, $t1, 1
    j ler

intervalo_2:
    addi $t2, $t2, 1
    j ler

intervalo_3:
    addi $t3, $t3, 1
    j ler

fim:
    # Mostrar quantidade [0-25]
    li $v0, 4
    la $a0, msg0
    syscall

    li $v0, 1
    move $a0, $t0
    syscall

    # Mostrar quantidade [26-50]
    li $v0, 4
    la $a0, msg1
    syscall

    li $v0, 1
    move $a0, $t1
    syscall

    # Mostrar quantidade [51-75]
    li $v0, 4
    la $a0, msg2
    syscall

    li $v0, 1
    move $a0, $t2
    syscall

    # Mostrar quantidade [76-100]
    li $v0, 4
    la $a0, msg3
    syscall

    li $v0, 1
    move $a0, $t3
    syscall

    # Encerrar
    li $v0, 10
    syscall
    
    .data
msg:     .asciiz "Digite a altura em cm: "
msgMenor: .asciiz "\nMenor altura: "
msgMaior: .asciiz "\nMaior altura: "

.text
.globl main

main:
    # Ler a primeira altura
    li $v0, 4
    la $a0, msg
    syscall

    li $v0, 5
    syscall
    move $t0, $v0       # $t0 = menor altura
    move $t1, $v0       # $t1 = maior altura

    # Contador: ja lemos 1 pessoa
    li $t2, 1

ler:
    # Verificar se ja foram lidas 15 pessoas
    li $t3, 15
    beq $t2, $t3, mostrar

    # Ler proxima altura
    li $v0, 4
    la $a0, msg
    syscall

    li $v0, 5
    syscall
    move $t4, $v0

    # Verificar se a altura e menor
    blt $t4, $t0, menor

    # Verificar se a altura e maior
    bgt $t4, $t1, maior

    # Se nao for menor nem maior
    addi $t2, $t2, 1
    j ler

menor:
    move $t0, $t4
    addi $t2, $t2, 1
    j ler

maior:
    move $t1, $t4
    addi $t2, $t2, 1
    j ler

mostrar:
    # Mostrar menor altura
    li $v0, 4
    la $a0, msgMenor
    syscall

    li $v0, 1
    move $a0, $t0
    syscall

    # Mostrar maior altura
    li $v0, 4
    la $a0, msgMaior
    syscall

    li $v0, 1
    move $a0, $t1
    syscall

    # Encerrar
    li $v0, 10
    syscall
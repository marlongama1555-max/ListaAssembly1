    syscall

    li $v0, 5
    syscall
    move $t1, $v0

    # Verificar se B e zero
    beq $t1, $zero, ler_b

    # Fazer A / B
    div $t0, $t1
    mflo $t2

    # Mostrar mensagem
    li $v0, 4
